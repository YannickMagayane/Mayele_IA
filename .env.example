# Required: Google Gemini API Key for RAG synthesis and embeddings
GEMINI_API_KEY_PRO=your_gemini_api_key_here

# Django Core Settings
SECRET_KEY=django-insecure-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Settings (Default: SQLite with WAL mode enabled)
# DATABASE_URL=sqlite:///observatory_rdc.db
